{
  "default_provider": "gemini",
  "default_model": "gemini-3.1-flash-lite",
  "providers": {
    "gemini": {
      "default_model": "gemini-3.5-flash-lite",
      "models": [
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-3.6-flash",
        "gemini-3.5-flash",
        "gemini-3.1-pro-preview",
        "gemma-4-31b-it",
        "gemma-4-26b-a4b-it"
      ]
    },
    "openrouter": {
      "default_model": "openai/gpt-oss-20b:free",
      "models": [
        "google/gemma-4-26b-a4b-it:free",
        "openai/gpt-oss-120b:free",
        "openai/gpt-oss-20b:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "nvidia/nemotron-3-nano-30b-a3b:free",
        "poolside/laguna-s-2.1:free",
        "poolside/laguna-xs-2.1:free",
        "inclusionai/ling-3.0-flash:free",
        "bytedance-seed/seedream-4.5"
      ]
    },
    "mock": {
      "default_model": "mock",
      "models": [
        "mock"
      ]
    }
  },
  "allowed_commands": [
    "ls",
    "cat",
    "mkdir",
    "cd",
    "pwd",
    "python",
    "pytest"
  ],
  "enable_checkpoints": true,
  "max_checkpoints": 50,
  "agents_md_enabled": true,
  "exclude_dirs": [
    ".git",
    ".agent_checkpoints",
    ".pytest_cache",
    ".adk",
    "node_modules",
    "__pycache__",
    ".venv",
    "children"
  ],
  "sandbox_enabled": false,
  "post_edit_import_check": true,
  "codebase_atlas_dir": "../atlas_output",
  "secrets_patterns": [
    "sk-[A-Za-z0-9]{15,}",
    "gh[pousrx]_[A-Za-z0-9]{15,}",
    "xox[bpsa]-[A-Za-z0-9]{10,}",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN (RSA |EC |OPENSSH )PRIVATE KEY-----"
  ],
  "debug_dump_append_mode": true,
  "debug_dump_enabled": true,
  "git_tools_enabled": false,
  "subagent_task_enabled": false,
  "tool_mode": "all",
  "tool_packs": {
    "file": true,
    "meta": false,
    "kernel": false,
    "debate": false,
    "sim": false,
    "git": false,
    "code_rag": false,
    "chain": false
  },
  "local_model": {
    "enabled": false,
    "provider": "ollama",
    "model": "gemma-2-2b-it",
    "endpoint": "http://localhost:11434",
    "local_categories": [
      "file",
      "meta"
    ],
    "fallback_to_cloud": true,
    "max_local_steps": 3,
    "timeout_seconds": 30
  },
  "rate_limits": {
    "llm_calls_per_minute": 10,
    "tool_writes_per_minute": 30
  },
  "tool_nudge_threshold": 20,
  "gemini_skip_tools_on_chain": true,
  "workflow_learn": {
    "enabled": true,
    "min_occurrences": 2,
    "max_sequence_len": 4,
    "in_loop": true,
    "session_end": true,
    "graph_evolve": true,
    "context_hints": true,
    "stale_after_days": 14,
    "min_savings_tokens": 0
  }
}