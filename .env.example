# Example environment (OPS-03 / OPS-06). Copy to .env and fill in — never commit.
# Nothing here is a real secret; `scripts/secret_scan.py` fails CI on real keys.

# --- Paths (no personal absolute paths in code or docs) ---------------------
# PIE_ROOT defaults to the repo root; PIE_DATA_ROOT defaults to $PIE_ROOT/data
# PIE_DATA_ROOT=/srv/pie/data
# FIREFLOW_ROOT=/srv/fireflow

# --- PIE server ------------------------------------------------------------
AGENT_PORT=8000
# AGENT_SKIP_AUTH=true          # local dev only; never in a deployed env
# CORS_ORIGINS=http://localhost:3000

# --- Models (OPS-07 caps spend per task, not per process) ------------------
# AGENT_PROVIDER=gemini
# AGENT_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=
# LLM_TASK_BUDGET_TOKENS=200000
# LLM_TASK_BUDGET_INR=50
# LLM_PRICING_JSON={"gemini-2.0-flash":{"in_per_1k":0.05,"out_per_1k":0.15}}

# --- FireFlow --------------------------------------------------------------
# FF_BASE_URL=http://localhost:5000
# JWT_SECRET=
# PIE_AGENT_KEY=               # scoped agent key: import/draft only, no send
# MONEY_MODE=test              # disabled | test | live (live needs a cap)
# MONEY_DAILY_CAP_PAISE=0

# --- Kernel ----------------------------------------------------------------
# CHROMA_DB_PATH=$PIE_DATA_ROOT/chroma_db
# CODEBASE_ATLAS_DIR=$PIE_ROOT/atlas_output

# --- Backups (OPS-01) ------------------------------------------------------
# BACKUP_DIR=/srv/pie/backups
# BACKUP_REMOTE=               # off-machine target; empty means "not configured"
