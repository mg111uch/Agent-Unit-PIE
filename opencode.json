{
  "$schema": "https://opencode.ai/config.json",
  
  "provider": {
    "groq": {
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen 3.6 27B",
          "limit": {
            "context": 131042,
            "output": 16384
          }
        }
      }
    },
    "tokenharbor": {
      "name": "Token Harbor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
